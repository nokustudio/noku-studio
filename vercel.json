{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/product.js": { "includeFiles": "{product.html,product-query.js}" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "redirects": [
    { "source": "/projects/cedar-house", "destination": "/projects/parijata-house", "permanent": true },
    { "source": "/projects/yucca-house", "destination": "/projects/parijata-house", "permanent": true },
    { "source": "/products/barstool", "destination": "/product?handle=barstool", "permanent": true },
    { "source": "/products/barstool-01", "destination": "/product?handle=barstool", "permanent": true },
    { "source": "/products/lounge-chair", "destination": "/product?handle=lounge-chair", "permanent": true },
    { "source": "/products/classic-study-table", "destination": "/product?handle=classic-study-table", "permanent": true },
    { "source": "/products/side-table", "destination": "/product?handle=side-table", "permanent": true },
    { "source": "/products/study-chair", "destination": "/product?handle=study-chair", "permanent": true },
    { "source": "/products/:slug", "destination": "/products", "permanent": true },
    { "source": "/collections/ofstillness", "destination": "/stillness", "permanent": true },
    { "source": "/collections", "destination": "/products", "permanent": true },
    { "source": "/cart", "destination": "/products", "permanent": true },
    { "source": "/collections/:slug", "destination": "/products", "permanent": true },
    { "source": "/catalog-copy", "destination": "/products", "permanent": true },
    { "source": "/home-copy", "destination": "/", "permanent": true },
    { "source": "/bespoke", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'wasm-unsafe-eval' https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: https://6b5390-f8.myshopify.com https://cdn.shopify.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.gstatic.com; worker-src 'self' blob:; child-src blob: https://forms.zohopublic.in https://www.google.com; frame-src https://forms.zohopublic.in https://www.google.com; form-action 'self' https://forms.zohopublic.in; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(self)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
